{
  "name": "cph-ng-monorepo",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "compile": "pnpm -r --parallel compile",
    "package": "tsx scripts/package.ts",
    "watch": "pnpm -r --parallel watch",
    "test": "pnpm -r --parallel test",
    "test:run": "pnpm -r --parallel test:run",
    "typecheck": "tsc --build",
    "lint": "biome check",
    "format": "biome check --write",
    "clean": "pnpm run --parallel clean && rimraf dist out scripts/out",
    "check-translations": "pnpm -r --parallel check-translations",
    "bump": "tsx scripts/bump-version.ts",
    "prepare": "tsx scripts/install-hooks.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@swc/core": "^1.16.20",
    "@types/node": "~22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "^5.0.5",
    "@vscode/vsce": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "ignore": "^7.0.13",
    "knip": "^6.42.1",
    "rimraf": "^6.1.3",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "webpack": "^5.112.1",
    "webpack-cli": "^7.2.3"
  }
}
