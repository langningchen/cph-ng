{
  "name": "cph-ng-monorepo",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "compile": "pnpm -r --parallel compile",
    "package": "tsx scripts/package.ts",
    "watch": "pnpm -r --parallel watch",
    "test": "pnpm -r --parallel test",
    "test:run": "pnpm -r --parallel test:run",
    "typecheck": "tsc --build",
    "lint": "biome check",
    "format": "biome check --write",
    "clean": "pnpm run --parallel clean && rimraf dist out scripts/out",
    "check-translations": "pnpm -r --parallel check-translations",
    "bump": "tsx scripts/bump-version.ts",
    "prepare": "tsx scripts/install-hooks.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@swc/core": "^1.16.1",
    "@types/node": "~22.19.7",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "^4.1.11",
    "@vscode/vsce": "^3.9.2",
    "copy-webpack-plugin": "^14.0.0",
    "ignore": "^7.0.6",
    "knip": "^6.32.3",
    "rimraf": "^6.1.3",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "webpack": "^5.110.1",
    "webpack-cli": "^7.2.2"
  }
}
